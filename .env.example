ANTHROPIC_API_KEY=your_key_here
# Password for the shared website link (Start Website.bat). Pick your own.
APP_PASSWORD=

# true = no password (testing only)
PASSWORD_OFF=false
# Only needed if the key gives a "not scoped to a workspace" error. Looks like wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# Shown under error messages as "Need help? ...". Example: Text the maintainer at 555-123-4567
HELP_CONTACT=
