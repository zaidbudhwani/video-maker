{
  "name": "video-maker-web-vendor",
  "private": true,
  "description": "Only used to refresh the two small browser files in web/vendor. The site itself is plain HTML and needs no build; Alex's computer never needs Node.",
  "scripts": {
    "vendor": "node -e \"const fs=require('fs');const c=(a,b)=>fs.copyFileSync(a,b);c('node_modules/gsap/dist/gsap.min.js','web/vendor/gsap.min.js');c('node_modules/lenis/dist/lenis.min.js','web/vendor/lenis.min.js');c('node_modules/lenis/dist/lenis.css','web/vendor/lenis.css')\"",
    "build:3d": "esbuild web/src/scene3d.src.js --bundle --minify --format=esm --target=es2020 --outfile=web/vendor/scene3d.js --legal-comments=none"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26"
  },
  "devDependencies": {
    "three": "0.186.1",
    "esbuild": "0.25.5"
  }
}
